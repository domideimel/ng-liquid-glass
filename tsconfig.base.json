{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@domideimel/ng-liquid-glass": ["./packages/ng-liquid-glass/src/index.ts"],
      "@domideimel/ng-liquid-glass/accordion": ["./packages/ng-liquid-glass/accordion/src/index.ts"],
      "@domideimel/ng-liquid-glass/alert": ["./packages/ng-liquid-glass/alert/src/index.ts"],
      "@domideimel/ng-liquid-glass/avatar": ["./packages/ng-liquid-glass/avatar/src/index.ts"],
      "@domideimel/ng-liquid-glass/badge": ["./packages/ng-liquid-glass/badge/src/index.ts"],
      "@domideimel/ng-liquid-glass/breadcrumbs": ["./packages/ng-liquid-glass/breadcrumbs/src/index.ts"],
      "@domideimel/ng-liquid-glass/button": ["./packages/ng-liquid-glass/button/src/index.ts"],
      "@domideimel/ng-liquid-glass/card": ["./packages/ng-liquid-glass/card/src/index.ts"],
      "@domideimel/ng-liquid-glass/combobox": ["./packages/ng-liquid-glass/combobox/src/index.ts"],
      "@domideimel/ng-liquid-glass/dialog": ["./packages/ng-liquid-glass/dialog/src/index.ts"],
      "@domideimel/ng-liquid-glass/forms": ["./packages/ng-liquid-glass/forms/src/index.ts"],
      "@domideimel/ng-liquid-glass/layout": ["./packages/ng-liquid-glass/layout/src/index.ts"],
      "@domideimel/ng-liquid-glass/menu": ["./packages/ng-liquid-glass/menu/src/index.ts"],
      "@domideimel/ng-liquid-glass/pagination": ["./packages/ng-liquid-glass/pagination/src/index.ts"],
      "@domideimel/ng-liquid-glass/progress": ["./packages/ng-liquid-glass/progress/src/index.ts"],
      "@domideimel/ng-liquid-glass/skeleton": ["./packages/ng-liquid-glass/skeleton/src/index.ts"],
      "@domideimel/ng-liquid-glass/tabs": ["./packages/ng-liquid-glass/tabs/src/index.ts"],
      "@domideimel/ng-liquid-glass/toast": ["./packages/ng-liquid-glass/toast/src/index.ts"],
      "@domideimel/ng-liquid-glass/tooltip": ["./packages/ng-liquid-glass/tooltip/src/index.ts"],
      "@ng-doc/generated": ["./ng-doc/docs/index.ts"],
      "@ng-doc/generated/*": ["./ng-doc/docs/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  "exclude": ["node_modules", "tmp"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictStandalone": true,
    "typeCheckHostBindings": true,
    "extendedDiagnostics": {
      "defaultCategory": "error"
    },
    "enableI18nLegacyMessageIdFormat": false
  }
}
