{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/packages/ng-liquid-glass",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "input": "styles",
      "glob": "**/*.css",
      "output": "styles"
    },
    {
      "input": ".",
      "glob": "README.md",
      "output": "."
    },
    {
      "input": "bin",
      "glob": "lg-contrast.mjs",
      "output": "bin"
    }
  ]
}
