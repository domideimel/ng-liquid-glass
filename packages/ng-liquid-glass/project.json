{
  "name": "ng-liquid-glass",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ng-liquid-glass",
  "prefix": "lg",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/ng-liquid-glass/ng-package.json",
        "tsConfig": "packages/ng-liquid-glass/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ng-liquid-glass/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "build-schematics": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["{projectRoot}/schematics/**/*", "!{projectRoot}/schematics/**/*.test.mjs"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/schematics"],
      "options": {
        "parallel": false,
        "commands": [
          "tsc -p packages/ng-liquid-glass/schematics/tsconfig.json",
          "node -e \"const fs=require('node:fs');const s='packages/ng-liquid-glass/schematics/',d='dist/packages/ng-liquid-glass/schematics/';for(const f of ['collection.json','ng-add/schema.json'])fs.copyFileSync(s+f,d+f);fs.writeFileSync(d+'package.json',JSON.stringify({type:'commonjs'})+'\\\\n')\""
        ]
      }
    },
    "test-schematics": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-schematics"],
      "options": {
        "command": "node --test packages/ng-liquid-glass/schematics/ng-add/ng-add.test.mjs packages/ng-liquid-glass/bin/lg-contrast.test.mjs"
      }
    },
    "build-test": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "packages/ng-liquid-glass/test/setup.ts",
        "tsConfig": "packages/ng-liquid-glass/tsconfig.spec.json",
        "outputPath": "dist/test-build/ng-liquid-glass",
        "styles": ["packages/ng-liquid-glass/test/styles.css"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["chromiumHeadless"],
        "setupFiles": ["packages/ng-liquid-glass/test/process-shim.ts", "packages/ng-liquid-glass/test/setup.ts"],
        "coverage": true,
        "coverageReporters": ["text-summary", "json-summary", "lcov", "html"],
        "coverageExclude": ["**/test/**", "**/*.spec.ts", "**/index.ts"],
        "coverageThresholds": {
          "statements": 95,
          "branches": 90,
          "functions": 95,
          "lines": 95
        },
        "buildTarget": "ng-liquid-glass:build-test"
      },
      "configurations": {
        "ci": {
          "reporters": ["default", "junit"],
          "outputFile": "dist/test-results/ng-liquid-glass/junit.xml"
        }
      }
    }
  }
}
